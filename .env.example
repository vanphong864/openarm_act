# Copy to .env (git-ignored) and fill in; every script reads it at start.
# A variable already set in the shell wins over this file.

# Weights & Biases: https://wandb.ai/authorize
WANDB_API_KEY=
# Your wandb user or team; empty: the account's default.
WANDB_ENTITY=

# Hugging Face: needed for DINOv3 (backbone=dinov3_*), whose weights are gated
# (request access on https://huggingface.co/facebook/dinov3-vitb16-pretrain-lvd1689m
# first), and
# for private datasets and export_policy.py repo_id=...:
# https://huggingface.co/settings/tokens (read access)
HF_TOKEN=
